# Copy to .env for local use, or add these as Secrets / Environment variables on your host.
# NEVER put the key in any file inside public/ and never commit a real .env.
# OPTIONAL. Visitors paste their OWN free Groq key on the page, so you do not need one.
# If you set this, it is used only when a visitor leaves the key box empty.
# GROQ_API_KEY=paste_your_groq_key_here
# Set to 1 to ignore GROQ_API_KEY and force every visitor to bring their own key
# USER_KEY_ONLY=1
# Optional
PORT=7860
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3
# Paid tier hook: comma separated keys that remove the watermark and allow longer videos (see planFor in server/app.js)
# PAID_KEYS=key1,key2
